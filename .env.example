# Copy to .env (never commit real values). All settings are optional.
UWT_ALLOWLIST=http://juice-shop:3000,http://dvwa:80  # exact origins allowed for scans; competition mode refuses every non-allowlisted URL
UWT_REQUIRE_ALLOWLIST_ALL_SCANS=true
# Docker Compose sets UWT_WORKER_MODE=external automatically.
# Omit UWT_WORKER_MODE for native development (inline worker is the default).
UWT_AI_ENABLED=true
UWT_OLLAMA_URL=http://127.0.0.1:11434      # local inference only
UWT_TEXT_MODEL=qwen2.5:1.5b
UWT_VISION_MODEL=qwen2.5vl:7b
# UWT_NUCLEI_BIN=/path/to/nuclei
# UWT_ZAP_URL=http://127.0.0.1:8090
# UWT_ZAP_API_KEY=            # backend-only secret, never exposed to the browser

# Authenticated Testing Configuration (Optional)
# UWT_AUTH_ENABLED=true
# UWT_AUTH_LOGIN_URL=https://example.com/login
# UWT_AUTH_USERNAME=user@example.com
# UWT_AUTH_PASSWORD=your_password
# UWT_AUTH_USER_SELECTOR=#emailInput
# UWT_AUTH_PASS_SELECTOR=#passwordInput
# UWT_AUTH_SUBMIT_SELECTOR=#loginBtn
