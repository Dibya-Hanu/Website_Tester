# Copy ONLY the open-source CPU libraries from the pinned upstream distribution.
# Upstream's optional NVIDIA accelerator directories never enter our runtime image.
FROM ollama/ollama:0.9.2 AS upstream
RUN mkdir -p /cpu-libs && \
    find /usr/lib/ollama -maxdepth 1 -type f -exec cp -a '{}' /cpu-libs/ \; && \
    find /cpu-libs -name 'libggml-cpu*.so' | grep -q .

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libstdc++6 libgomp1 && rm -rf /var/lib/apt/lists/*
COPY --from=upstream /usr/bin/ollama /usr/bin/ollama
COPY --from=upstream /cpu-libs/ /usr/lib/ollama/
COPY third_party/licenses/ /usr/share/doc/ollama/licenses/
ENV OLLAMA_HOST=0.0.0.0:11434 LD_LIBRARY_PATH=/usr/lib/ollama
EXPOSE 11434
ENTRYPOINT ["ollama"]
CMD ["serve"]
