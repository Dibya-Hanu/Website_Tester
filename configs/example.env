# Copy to .env in the project root (or export as environment variables). All values optional.
# Only origins listed here may be scanned in strict competition mode. Exact scheme+host+port match.
UWT_ALLOWLIST=http://127.0.0.1:8765
UWT_REQUIRE_ALLOWLIST_ALL_SCANS=true
UWT_AI_ENABLED=true
UWT_OLLAMA_URL=http://127.0.0.1:11434
UWT_TEXT_MODEL=qwen2.5:1.5b
UWT_VISION_MODEL=qwen2.5vl:7b
UWT_MAX_PAGES=8
UWT_MAX_DEPTH=2
# Optional: path to a Nuclei binary, and a ZAP API endpoint (ZAP is skipped if unreachable)
# UWT_NUCLEI_BIN=bin/nuclei
# UWT_ZAP_URL=http://127.0.0.1:8090
